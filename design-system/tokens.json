{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "DrufiyAI Precision Engineering",
  "version": "1.0.0",
  "color": {
    "background": {
      "canvas": { "$type": "color", "$value": "#08090A" },
      "subtle": { "$type": "color", "$value": "#0B1110" },
      "raised": { "$type": "color", "$value": "#0F1114" },
      "card": { "$type": "color", "$value": "#151820" },
      "cardHover": { "$type": "color", "$value": "#1A1E28" },
      "cream": { "$type": "color", "$value": "#FDF1E1" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#F0F2F5" },
      "secondary": { "$type": "color", "$value": "#A0A8B8" },
      "muted": { "$type": "color", "$value": "#6E778D" },
      "inverse": { "$type": "color", "$value": "#08090A" }
    },
    "accent": {
      "start": { "$type": "color", "$value": "#34D399" },
      "solid": { "$type": "color", "$value": "#3BE8B0" },
      "end": { "$type": "color", "$value": "#06B6D4" }
    },
    "status": {
      "live": { "$type": "color", "$value": "#34D399" },
      "info": { "$type": "color", "$value": "#60A5FA" },
      "warning": { "$type": "color", "$value": "#FBBF24" },
      "error": { "$type": "color", "$value": "#F87171" }
    }
  },
  "typography": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Ogg Medium", "Georgia", "serif"] },
      "body": { "$type": "fontFamily", "$value": ["Inter", "Satoshi", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "SFMono-Regular", "monospace"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "black": { "$type": "fontWeight", "$value": 800 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "32": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "999rem" }
  },
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "100ms" },
      "fast": { "$type": "duration", "$value": "180ms" },
      "normal": { "$type": "duration", "$value": "300ms" },
      "slow": { "$type": "duration", "$value": "500ms" },
      "slower": { "$type": "duration", "$value": "800ms" },
      "cinematic": { "$type": "duration", "$value": "1200ms" }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
      "inOut": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] },
      "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] },
      "cinematic": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] }
    }
  }
}
